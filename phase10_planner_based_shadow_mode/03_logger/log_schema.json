{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase10 integrated shadow sample",
  "type": "object",
  "required": [
    "trial_id", "condition_id", "layout_id", "episode_id", "frame_id",
    "timestamp_camera", "timestamp_state", "timestamp_planner", "instruction",
    "planner_raw_action", "planner_executed_action", "openvla_executed_action",
    "oft_executed_action", "phase", "valid", "exclusion_reason"
  ],
  "properties": {
    "trial_id": {"type": "string"},
    "condition_id": {"type": "string"},
    "layout_id": {"type": "string"},
    "episode_id": {"type": "string"},
    "frame_id": {"type": "integer", "minimum": 0},
    "planner_step": {"type": "integer", "minimum": 0},
    "timestamp_camera": {"type": ["number", "null"]},
    "timestamp_state": {"type": ["number", "null"]},
    "timestamp_planner": {"type": ["number", "null"]},
    "timestamp_openvla": {"type": ["number", "null"]},
    "timestamp_oft": {"type": ["number", "null"]},
    "raw_image_path": {"type": "string"},
    "raw_image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_input_image_path": {"type": ["string", "null"]},
    "instruction": {"type": "string"},
    "raw_joint_position": {"type": ["array", "null"]},
    "raw_joint_velocity": {"type": ["array", "null"]},
    "raw_ee_position": {"type": ["array", "null"]},
    "raw_ee_rotation": {"type": ["array", "null"]},
    "raw_gripper_state": {"type": ["number", "null"]},
    "pose_source": {"type": ["string", "null"]},
    "planner_target": {},
    "planner_raw_action": {"type": ["array", "null"]},
    "planner_canonical_action": {"type": ["object", "null"]},
    "planner_executed_action": {"type": ["array", "null"]},
    "robot_delivered_command": {"type": ["array", "null"]},
    "measured_post_state": {"type": ["object", "null"]},
    "openvla_raw_action": {},
    "openvla_denormalized_action": {"type": ["array", "null"]},
    "openvla_canonical_action": {"type": ["object", "null"]},
    "openvla_executed_action": {"type": "null"},
    "oft_raw_action_chunk": {},
    "oft_denormalized_action_chunk": {"type": ["array", "null"]},
    "oft_canonical_action_chunk": {"type": ["array", "null"]},
    "oft_executed_action": {"type": "null"},
    "gripper_postprocessed_action": {"type": ["number", "null"]},
    "inference_latency_openvla": {"type": ["number", "null"]},
    "inference_latency_oft": {"type": ["number", "null"]},
    "timeout_flags": {"type": "object"},
    "communication_flags": {"type": "object"},
    "hold_flags": {"type": "object"},
    "emergency_stop_flags": {"type": "object"},
    "phase": {"type": "string"},
    "valid": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "collection_mode": {"const": "recorded-input shadow"}
  }
}

